##########################################################
# 1. DATABASE (Postgres)
##########################################################
# Chạy bằng docker-compose (mặc định):
DATABASE_URL="postgresql://pheni:pheni@localhost:5432/pheni_volunteer?schema=public"
# Nếu deploy Vercel + Neon/Supabase, dán connection string của họ vào đây.
# Neon ví dụ: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

##########################################################
# 2. AUTH (Auth.js v5)
##########################################################
# Sinh khoá: openssl rand -base64 32
AUTH_SECRET="doi-thanh-mot-chuoi-random-32-ky-tu"
# URL gốc của site. Local: http://localhost:3000 — Vercel tự nhận, có thể bỏ trống.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth — tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Chỉ cho phép email thuộc các domain sau (phân tách bởi dấu phẩy)
ALLOWED_EMAIL_DOMAINS="st.phenikaa-uni.edu.vn,phenikaa-uni.edu.vn"

# Đăng nhập tạm bằng email (KHÔNG dùng ở production) để test khi chưa có Google OAuth.
# Bật: "true". Mật khẩu chung khai báo ở DEV_LOGIN_PASSWORD.
ALLOW_DEV_LOGIN="false"
DEV_LOGIN_PASSWORD="phenikaa-dev"

##########################################################
# 3. ROOT ADMIN
##########################################################
# Các email này luôn được nâng quyền Root Admin khi đăng nhập / khi chạy seed.
ROOT_ADMIN_EMAILS="admin@phenikaa-uni.edu.vn"

##########################################################
# 4. EMAIL (SMTP - Nodemailer)
##########################################################
# Gmail / Google Workspace: host smtp.gmail.com, port 465, secure true,
# SMTP_PASS = App Password 16 ký tự (https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CLB Tình nguyện Phenikaa <no-reply@phenikaa-uni.edu.vn>"
# Bỏ trống SMTP_HOST => mail chỉ được ghi vào DB (xem ở /admin/emails), không gửi thật.
MAIL_ENABLED="true"

# Bảo vệ endpoint cron gửi mail: /api/cron/emails?key=...
CRON_SECRET="doi-thanh-chuoi-random"

##########################################################
# 5. KHÁC
##########################################################
NEXT_PUBLIC_APP_NAME="Phenikaa Volunteer"
TZ="Asia/Ho_Chi_Minh"
