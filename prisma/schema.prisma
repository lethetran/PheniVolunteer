// ============================================================
//  Phenikaa Volunteer — schema quản lý tình nguyện viên
//  Postgres + Prisma. Chạy: npx prisma migrate deploy
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------- ENUMS -------------------------------

/// 4 cấp quyền của hệ thống
enum Role {
  ROOT_ADMIN // Toàn quyền: tạo/xoá admin, cấp quyền, cấu hình hệ thống
  ADMIN // Quyền do Root cấp: tạo chiến dịch, quản lý TNV, duyệt...
  MANAGER // Quản lý nhóm nhỏ trong chiến dịch, quyền do Admin cấp
  VOLUNTEER // Tình nguyện viên
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum CampaignStatus {
  DRAFT // Nháp, TNV chưa thấy
  OPEN // Đang mở đăng ký
  CLOSED // Đóng đăng ký, chưa diễn ra
  ONGOING // Đang diễn ra
  FINISHED // Đã kết thúc
  ARCHIVED // Lưu trữ
}

enum RegistrationStatus {
  PENDING // Chờ duyệt
  APPROVED // Đã duyệt
  REJECTED // Bị từ chối
  WAITLIST // Danh sách chờ
  CANCELLED // TNV tự huỷ
  REMOVED // Bị loại khỏi chiến dịch
}

enum AttendanceStatus {
  NOT_YET
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// Cột thông tin động được tạo cho phạm vi nào
enum FieldScope {
  VOLUNTEER_PROFILE // Cột thêm vào hồ sơ TNV (toàn hệ thống)
  REGISTRATION_FORM // Câu hỏi trong form đăng ký của 1 chiến dịch
  MEMBER_TRACKING // Cột theo dõi thành viên trong chiến dịch (áo, ca, nhiệm vụ...)
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTISELECT
  CHECKBOX
  EMAIL
  PHONE
  URL
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED // TNV đã báo cáo, chờ quản lý xác nhận
  DONE
  BLOCKED // Đang vướng, có vấn đề
}

enum NoteSeverity {
  INFO
  WARNING
  ISSUE
  BLOCKER
}

enum NoteStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ImportStatus {
  PROCESSING
  DONE
  PARTIAL
  FAILED
}

// ---------------------- AUTH.JS -----------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------- NGƯỜI DÙNG --------------------------

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          Role       @default(VOLUNTEER)
  status        UserStatus @default(ACTIVE)

  /// Quyền toàn hệ thống mà Root Admin cấp cho Admin (xem src/lib/permissions.ts)
  permissions String[] @default([])

  // Hồ sơ TNV
  studentCode String? // Mã sinh viên
  phone       String?
  faculty     String? // Khoa / Viện
  className   String? // Lớp
  dob         DateTime?
  gender      String?
  address     String?
  bio         String?

  /// Giá trị của các cột hồ sơ động (FieldScope.VOLUNTEER_PROFILE) — { fieldKey: value }
  profileData Json @default("{}")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  registrations     Registration[]
  groupAssignments  GroupAssignment[]
  campaignAdmins    CampaignAdmin[]
  taskProgress      TaskProgress[]
  notifications     Notification[]
  createdCampaigns  Campaign[]         @relation("CampaignCreator")
  authoredNotes     Note[]             @relation("NoteAuthor")
  resolvedNotes     Note[]             @relation("NoteResolver")
  subjectNotes      Note[]             @relation("NoteSubject")
  decidedRegs       Registration[]     @relation("RegistrationDecider")
  auditLogs         AuditLog[]
  importJobs        ImportJob[]
  createdTasks      Task[]             @relation("TaskCreator")
  posts             Post[]
  createdFields     FieldDefinition[]  @relation("FieldCreator")

  @@index([role])
  @@index([studentCode])
}

// ---------------------- CHIẾN DỊCH --------------------------

model Campaign {
  id          String         @id @default(cuid())
  code        String         @unique // Mã chiến dịch, vd: TN2026-01
  title       String
  slug        String         @unique
  summary     String? // Mô tả ngắn hiện ở thẻ chiến dịch
  description String?        @db.Text
  coverImage  String?
  location    String?
  organizer   String?
  status      CampaignStatus @default(DRAFT)

  startAt      DateTime?
  endAt        DateTime?
  regOpenAt    DateTime?
  regCloseAt   DateTime?
  capacity     Int? // Số lượng TNV tối đa (null = không giới hạn)
  hoursDefault Float?  @default(0) // Số giờ tình nguyện mặc định khi hoàn thành
  pointsDefault Int?   @default(0) // Điểm rèn luyện / điểm CTXH mặc định

  requireApproval Boolean @default(true) // Admin phải duyệt thành viên
  allowSelfJoin   Boolean @default(true) // TNV tự đăng ký được

  createdById String?
  createdBy   User?    @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups        CampaignGroup[]
  registrations Registration[]
  fields        FieldDefinition[]
  tasks         Task[]
  notes         Note[]
  posts         Post[]
  admins        CampaignAdmin[]

  @@index([status])
  @@index([startAt])
}

/// Nhóm nhỏ trong chiến dịch (phân cấp), có quản lý nhóm riêng
model CampaignGroup {
  id           String  @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  quota        Int? // Chỉ tiêu thành viên của nhóm
  meetingPoint String?
  shift        String? // Ca / khung giờ
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments   GroupAssignment[]
  registrations Registration[]
  tasks         Task[]

  @@unique([campaignId, name])
  @@index([campaignId])
}

/// Gán quản lý cho nhóm nhỏ + quyền cụ thể do Admin cấp
model GroupAssignment {
  id          String   @id @default(cuid())
  groupId     String
  group       CampaignGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] @default([]) // xem GROUP_PERMISSIONS trong src/lib/permissions.ts
  title       String? // Chức danh: Trưởng nhóm, Phó nhóm...
  createdAt   DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// Admin phụ trách 1 chiến dịch cụ thể (đồng quản lý)
model CampaignAdmin {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[] @default([])
  createdAt   DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
}

// ---------------------- ĐĂNG KÝ / THÀNH VIÊN ----------------

model Registration {
  id         String             @id @default(cuid())
  campaignId String
  campaign   Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId    String?
  group      CampaignGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status     RegistrationStatus @default(PENDING)

  /// Câu trả lời form đăng ký (FieldScope.REGISTRATION_FORM) — { fieldKey: value }
  formData Json @default("{}")

  /// Cột theo dõi thành viên (FieldScope.MEMBER_TRACKING) — { fieldKey: value }
  trackingData Json @default("{}")

  motivation String? @db.Text // Lý do tham gia
  note       String? @db.Text // Ghi chú nội bộ nhanh

  attendance    AttendanceStatus @default(NOT_YET)
  checkInAt     DateTime?
  checkOutAt    DateTime?
  hoursAwarded  Float            @default(0)
  pointsAwarded Int              @default(0)
  completed     Boolean          @default(false)

  appliedAt    DateTime  @default(now())
  decidedAt    DateTime?
  decidedById  String?
  decidedBy    User?     @relation("RegistrationDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  rejectReason String?
  updatedAt    DateTime  @updatedAt

  taskProgress TaskProgress[]
  notes        Note[]

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@index([userId])
  @@index([groupId])
}

// ---------------------- CỘT THÔNG TIN ĐỘNG ------------------

model FieldDefinition {
  id         String     @id @default(cuid())
  scope      FieldScope
  campaignId String? // null với VOLUNTEER_PROFILE (áp dụng toàn hệ thống)
  campaign   Campaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  key         String // khoá lưu trong JSON, vd: size_ao
  label       String // nhãn hiển thị, vd: "Size áo"
  type        FieldType @default(TEXT)
  options     String[]  @default([]) // cho SELECT / MULTISELECT
  placeholder String?
  helpText    String?
  required    Boolean   @default(false)
  order       Int       @default(0)
  archived    Boolean   @default(false)

  visibleToVolunteer  Boolean @default(true) // TNV có thấy cột này không
  editableByVolunteer Boolean @default(false) // TNV có tự điền/sửa được không

  createdById String?
  createdBy   User?    @relation("FieldCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, campaignId, key])
  @@index([campaignId, scope])
}

// ---------------------- NHIỆM VỤ ----------------------------

model Task {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  groupId     String? // null = áp dụng cho toàn chiến dịch
  group       CampaignGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  dueAt       DateTime?
  required    Boolean  @default(true)
  requireEvidence Boolean @default(false) // Bắt buộc nộp link/minh chứng
  order       Int      @default(0)

  createdById String?
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress TaskProgress[]

  @@index([campaignId])
  @@index([groupId])
}

model TaskProgress {
  id             String       @id @default(cuid())
  taskId         String
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  status      TaskStatus @default(NOT_STARTED)
  evidenceUrl String?
  report      String?    @db.Text // TNV mô tả kết quả
  reviewNote  String?    @db.Text // Quản lý nhận xét
  submittedAt DateTime?
  completedAt DateTime?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())

  notes Note[]

  @@unique([taskId, userId])
  @@index([userId, status])
}

// ---------------------- GHI CHÚ / VẤN ĐỀ --------------------

model Note {
  id       String  @id @default(cuid())
  body     String  @db.Text
  severity NoteSeverity @default(INFO)
  status   NoteStatus   @default(OPEN)

  /// true = TNV liên quan cũng đọc được, false = chỉ ban tổ chức
  sharedWithVolunteer Boolean @default(false)

  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  taskProgressId String?
  taskProgress   TaskProgress? @relation(fields: [taskProgressId], references: [id], onDelete: Cascade)

  /// TNV được nói đến trong ghi chú
  subjectId String?
  subject   User?   @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("NoteResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@index([registrationId])
  @@index([subjectId])
}

// ---------------------- THÔNG TIN / TIN BÀI -----------------

model Post {
  id         String    @id @default(cuid())
  campaignId String? // null = thông báo toàn hệ thống
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  body       String    @db.Text
  pinned     Boolean   @default(false)
  published  Boolean   @default(true)

  /// Đã gửi email tới thành viên chưa
  emailSentAt DateTime?

  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, published])
}

// ---------------------- THÔNG BÁO / EMAIL -------------------

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String // REGISTRATION_APPROVED, TASK_ASSIGNED, ...
  title  String
  body   String? @db.Text
  link   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

/// Hàng đợi email — mọi mail đều đi qua đây nên không bao giờ mất, có retry & log
model EmailMessage {
  id        String      @id @default(cuid())
  to        String
  subject   String
  html      String      @db.Text
  text      String?     @db.Text
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?     @db.Text
  /// Khoá chống gửi trùng (vd: reg-approved:<registrationId>)
  dedupeKey String?     @unique
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
}

// ---------------------- IMPORT EXCEL ------------------------

model ImportJob {
  id       String       @id @default(cuid())
  kind     String // "VOLUNTEERS" | "CAMPAIGN_MEMBERS"
  fileName String
  status   ImportStatus @default(PROCESSING)

  campaignId  String?
  totalRows   Int    @default(0)
  createdRows Int    @default(0)
  updatedRows Int    @default(0)
  errorRows   Int    @default(0)
  /// [{ row: 3, email: "...", message: "..." }]
  errors      Json   @default("[]")

  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------------------- AUDIT LOG ---------------------------

model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actor      User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // "campaign.create", "registration.approve", ...
  entityType String?
  entityId   String?
  metadata   Json    @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// ---------------------- CẤU HÌNH ----------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
